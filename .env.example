# 하이웍스 SMTP 발신 계정 (앱 비밀번호 권장)
HIWORKS_SMTP_USER=your-sender@yourdomain.com
# # 등 특수문자가 있으면 반드시 따옴표로 감싸기
HIWORKS_SMTP_PASS="your-mail-only-or-app-password"

# 메일 규칙(자동 분류)이 설정된 수신 계정
TARGET_EMAIL=board-receiver@yourdomain.com

# --- PC 전용: post_board_from_mail.py (서버 .env 에는 BOARD URL 불필요) ---
HIWORKS_OFFICE_HOME=https://login.office.hiworks.com/yourdomain.com
# 로그인 화면 ID 자동 입력 (비우면 HIWORKS_SMTP_USER 사용)
# HIWORKS_LOGIN_ID=you@yourdomain.com
# HIWORKS_LOGIN_ID_PREFILL=1  (0 이면 ID 자동 입력 끔. 1단계 ID만 채움, '다음'은 수동)
# 게시: board_form = 웹메일 본문 읽기 → 글쓰기 URL 등록 (권장)
HIWORKS_POST_METHOD=board_form
HIWORKS_BOARD_WRITE_URL=https://boards.office.hiworks.com/board/postwrite/normal/328/new

# (레거시) mail_menu = 메일 「게시판에 등록하기」 UI
# HIWORKS_POST_METHOD=mail_menu
# HIWORKS_BOARD_NAME=정보보안 뉴스레터

# digest가 받은편지함이 아닌 개인편지함으로 분류되면 웹메일 목록 URL 지정 (POP3는 받은편지함만)
# HIWORKS_MAIL_FETCH=web
# HIWORKS_MAIL_LIST_URL=https://mails.office.hiworks.com/list/personal/717?page=1
# digest HTML 본문 iframe (하이웍스 웹메일 읽기 — ID 권장, class hash는 빌드마다 바뀔 수 있음)
HIWORKS_MAIL_BODY_IFRAME=#viewContentIframeId
# HIWORKS_MAIL_BODY_INNER_SELECTOR=body
# 한 줄: HIWORKS_MAIL_BODY_SELECTOR=#viewContentIframeId >> body
# 받은편지함: https://mails.office.hiworks.com/list/inbox?page=1
